# Copy to .env and adjust per machine. Every value below is the default.

# Knowledge-base source folder (relative paths are resolved from the project root)
KB_RAW_DIR=data/raw

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=iso27001_kb
QDRANT_TIMEOUT=60

# Embeddings (local Ollama)
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=120
# Task prefixes, only for models trained with them (nomic-embed-text: "search_document: " / "search_query: ")
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

# Chunking, in words: guidance units under MIN are merged with a neighbour, units over MAX are split
CHUNK_MIN_WORDS=40
CHUNK_MAX_WORDS=200

# Stage 2 retrieval: BM25 + semantic, fused with RRF, then reranked
RETRIEVAL_CANDIDATES_PER_RETRIEVER=20
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSION_TOP_K=20

RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=16
RERANK_TOP_K=5

# Stage 3 generation (local Ollama chat model)
GENERATION_BASE_URL=http://localhost:11434
GENERATION_MODEL=llama3:8b
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=600
GENERATION_TIMEOUT=120
GENERATION_LANGUAGE=fr

# Stage 4 report generation
REPORT_OUTPUT_DIR=data/reports

# Client document import
DOCUMENT_IMPORT_DIR=data/imports

# Development phase: persistent storage (replaces the JSON-file session store) and API auth.
# A dedicated Postgres container/port, never the machine's other Postgres instance(s):
#   docker run -d --name iso27001_audit_postgres -e POSTGRES_USER=audit_app \
#     -e POSTGRES_PASSWORD=<choose one> -e POSTGRES_DB=iso27001_audit \
#     -p 5433:5432 -v iso27001_audit_pgdata:/var/lib/postgresql/data postgres:15-alpine
DATABASE_URL=postgresql+psycopg2://audit_app:dev_local_only_change_me@localhost:5433/iso27001_audit
# Generate a real secret for anything beyond local development: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
